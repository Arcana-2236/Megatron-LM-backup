#!/bin/bash -l
#PBS -N throughput_opt
#PBS -A TensorCompress
#PBS -q debug
#PBS -l select=1:ncpus=64:ngpus=4
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe

set -euo pipefail

module use /soft/modulefiles
module load conda cudatoolkit-standalone/12.4.1
set +u
conda activate dspeed_env
set -u

ROOT_DIR=${ROOT_DIR:-/home/$USER/offloading/ATC-Megatron}
RESULT_DIR=${RESULT_DIR:-$ROOT_DIR/benchmarks/0525/throughput_optimization_20260526T053247Z}
cd "$ROOT_DIR"

export TMPDIR=${TMPDIR:-/var/tmp/pbs.${PBS_JOBID}}
EAGLE_PROJECT_DIR=${EAGLE_PROJECT_DIR:-/eagle/TensorCompress/$USER}
if [ -d "$EAGLE_PROJECT_DIR" ] && [ -w "$EAGLE_PROJECT_DIR" ]; then
  export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$EAGLE_PROJECT_DIR/cache/pip}
  export UV_CACHE_DIR=${UV_CACHE_DIR:-$EAGLE_PROJECT_DIR/cache/uv}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$EAGLE_PROJECT_DIR/cache/torch_extensions}
else
  export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$TMPDIR/pip}
  export UV_CACHE_DIR=${UV_CACHE_DIR:-$TMPDIR/uv}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$TMPDIR/torch_extensions}
fi
mkdir -p "$TMPDIR" "$PIP_CACHE_DIR" "$UV_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$RESULT_DIR"

export NNODES=$(awk '!seen[$0]++' "$PBS_NODEFILE" | wc -l)
export GPUS_PER_NODE=4
export MASTER_ADDR=$(head -n 1 "$PBS_NODEFILE")
export MASTER_PORT=${MASTER_PORT:-$((10000 + RANDOM % 50000))}
export PYTHON=${PYTHON:-$(which python)}

MODEL_SIZE=${MODEL_SIZE:-3b}
MODEL_IMPL=${MODEL_IMPL:-baseline}
STRATEGY=${STRATEGY:-distopt}
OFFLOAD=${OFFLOAD:-0}
CUDA_GRAPH=${CUDA_GRAPH:-0}
OPT_LABEL=${OPT_LABEL:-baseline}
TRAIN_ITERS=${TRAIN_ITERS:-20}
TIMING_LOG_LEVEL=${TIMING_LOG_LEVEL:-1}
TIMING_LOG_OPTION=${TIMING_LOG_OPTION:-minmax}

impl_label=$MODEL_IMPL
if [ "$impl_label" = "baseline" ]; then
  impl_label=fullrank
fi
runtime_label=$STRATEGY
if [ "$OFFLOAD" = "1" ]; then
  runtime_label="${runtime_label}_offload"
fi
if [ "$CUDA_GRAPH" = "1" ]; then
  runtime_label="${runtime_label}_cudagraph"
fi
opt_slug=$(echo "$OPT_LABEL" | tr ' /+' '___' | tr -cd '[:alnum:]_.-')
RUN_ID=${RUN_ID:-throughput_${MODEL_SIZE}_${impl_label}_${runtime_label}_${opt_slug}}

export MODEL_SIZE MODEL_IMPL STRATEGY OFFLOAD CUDA_GRAPH TRAIN_ITERS TIMING_LOG_LEVEL TIMING_LOG_OPTION
export RESULTS_ROOT="$RESULT_DIR"
export RUN_ID

echo "PBS_JOBID=$PBS_JOBID"
echo "ROOT_DIR=$ROOT_DIR"
echo "RESULT_DIR=$RESULT_DIR"
echo "RUN_ID=$RUN_ID"
echo "MODEL_SIZE=$MODEL_SIZE MODEL_IMPL=$MODEL_IMPL STRATEGY=$STRATEGY OFFLOAD=$OFFLOAD CUDA_GRAPH=$CUDA_GRAPH OPT_LABEL=$OPT_LABEL"
echo "NNODES=$NNODES GPUS_PER_NODE=$GPUS_PER_NODE MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT"
cat "$PBS_NODEFILE"

benchmarks/cola_memory/run_one.sh

