#!/bin/bash -l
#PBS -N cola_smoke
#PBS -A TensorCompress
#PBS -q debug
#PBS -l select=1:ncpus=64:ngpus=1
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:eagle
#PBS -j oe

set -euo pipefail

module use /soft/modulefiles
module load conda cudatoolkit-standalone/12.4.1
set +u
conda activate dspeed_env
set -u

ROOT_DIR=${ROOT_DIR:-/home/$USER/offloading/ATC-Megatron}
cd "$ROOT_DIR"

export TMPDIR=${TMPDIR:-/var/tmp/pbs.${PBS_JOBID}}
if [ -d "/eagle/$USER" ]; then
  DEFAULT_RESULTS_ROOT="/eagle/$USER/atc_megatron_cola_smoke/${PBS_JOBID}"
  export PIP_CACHE_DIR=${PIP_CACHE_DIR:-/eagle/$USER/cache/pip}
  export UV_CACHE_DIR=${UV_CACHE_DIR:-/eagle/$USER/cache/uv}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-/eagle/$USER/cache/torch_extensions}
else
  DEFAULT_RESULTS_ROOT="$ROOT_DIR/benchmarks/cola_memory/results/smoke_${PBS_JOBID}"
  export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$TMPDIR/pip}
  export UV_CACHE_DIR=${UV_CACHE_DIR:-$TMPDIR/uv}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$TMPDIR/torch_extensions}
fi
export RESULTS_ROOT=${RESULTS_ROOT:-$DEFAULT_RESULTS_ROOT}
export PYTHON=${PYTHON:-$(which python)}
export GPUS_PER_NODE=1
export NNODES=1
export NODE_RANK=0
export MASTER_ADDR=localhost
export MASTER_PORT=${MASTER_PORT:-$((10000 + RANDOM % 50000))}

mkdir -p "$TMPDIR" "$PIP_CACHE_DIR" "$UV_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$RESULTS_ROOT"

echo "PBS_JOBID=$PBS_JOBID"
echo "ROOT_DIR=$ROOT_DIR"
echo "RESULTS_ROOT=$RESULTS_ROOT"
echo "PYTHON=$PYTHON"
echo "MASTER_PORT=$MASTER_PORT"
python - <<'PY'
import sys
import torch
print("python", sys.version)
print("torch", torch.__version__, "cuda", torch.version.cuda, "available", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0))
PY

MODEL_SIZE=tiny MODEL_IMPL=baseline STRATEGY=baseline OFFLOAD=0 CUDA_GRAPH=0 \
  TRAIN_ITERS=2 WARMUP_ITERS=0 RUN_ID="smoke_baseline_${PBS_JOBID}" \
  bash benchmarks/cola_memory/run_one.sh

MODEL_SIZE=tiny MODEL_IMPL=cola STRATEGY=baseline OFFLOAD=0 CUDA_GRAPH=0 \
  TRAIN_ITERS=2 WARMUP_ITERS=0 RUN_ID="smoke_cola_${PBS_JOBID}" \
  bash benchmarks/cola_memory/run_one.sh

python benchmarks/cola_memory/parse_results.py --results-root "$RESULTS_ROOT" --warmup 0
